# ---- Supabase (Postgres + pgvector) ----
# Use the SERVICE ROLE key on the server side so the repository can bypass RLS.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ---- OpenRouter (embeddings) ----
OPENROUTER_API_KEY=
# Multimodal embedding model used for BOTH entity descriptions and media.
EMBEDDING_MODEL=google/gemini-embedding-2
# Must be passed explicitly: the model defaults to 3072 otherwise.
# 1536 is chosen because pgvector's hnsw index only supports <=2000 dims for the
# native vector type, and 1536 matches 3072 on MTEB at half the storage.
EMBEDDING_DIMENSIONS=1536

# ---- WAHA (unofficial WhatsApp HTTP API) ----
# https://waha.devlike.pro
WAHA_BASE_URL=http://localhost:3000
WAHA_API_KEY=
WAHA_SESSION=default

# ---- Webhook server ----
PORT=8080
# Optional shared secret checked against WAHA's X-Api-Key / webhook hmac if configured.
WEBHOOK_SECRET=
