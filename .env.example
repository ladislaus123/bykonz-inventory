# ---- Supabase (Postgres + pgvector) ----
# Use the SERVICE ROLE key on the server side so the repository can bypass RLS.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ---- Object storage (uploaded card/brochure images) ----
# 'supabase' = native Storage API (auto-creates bucket); 's3' = S3-compatible endpoint.
STORAGE_DRIVER=s3
STORAGE_BUCKET=business-cards
# S3 settings (used only when STORAGE_DRIVER=s3). Supabase's S3 protocol endpoint
# looks like https://<project-ref>.storage.supabase.co/storage/v1/s3
S3_ENDPOINT=https://YOUR-PROJECT.storage.supabase.co/storage/v1/s3
S3_REGION=us-west-2
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---- OpenRouter (embeddings) ----
OPENROUTER_API_KEY=
# Multimodal embedding model used for BOTH entity descriptions and media.
EMBEDDING_MODEL=google/gemini-embedding-2
# Must be passed explicitly: the model defaults to 3072 otherwise.
# 1536 is chosen because pgvector's hnsw index only supports <=2000 dims for the
# native vector type, and 1536 matches 3072 on MTEB at half the storage.
EMBEDDING_DIMENSIONS=1536

# ---- Enrichment agent (agentic loop) ----
# Must be vision + tool-calling capable on OpenRouter.
AGENT_MODEL=google/gemini-2.5-flash
AGENT_SEARCH_MODEL=google/gemini-2.5-flash
AGENT_MAX_STEPS=6
AGENT_WEB_MAX_RESULTS=5

# ---- Background worker ----
WORKER_ENABLED=true
WORKER_POLL_MS=3000

# ---- Voice transcription (Deepgram) ----
# Speech-to-text for inbound WhatsApp/Telegram voice messages.
# Create a key at https://console.deepgram.com. Leave DEEPGRAM_API_KEY blank to
# disable voice (the bot will ask users to type instead).
DEEPGRAM_API_KEY=
# Deepgram model (nova-2 is multilingual and supports Portuguese).
DEEPGRAM_MODEL=nova-2
# BCP-47 language code for transcription.
DEEPGRAM_LANGUAGE=pt

# ---- Messaging transport ----
# Which backend(s) drive the conversation flow. Comma-separated to run several at
# once; each user is answered on the channel they wrote in on.
#   'waha'     = WhatsApp via WAHA (webhook-driven; set WAHA_* below)
#   'telegram' = Telegram Bot API (self-contained long polling; set TELEGRAM_* below)
# e.g.  TRANSPORT_DRIVER=waha,telegram
TRANSPORT_DRIVER=waha

# ---- WAHA (unofficial WhatsApp HTTP API) ----
# https://waha.devlike.pro
WAHA_BASE_URL=http://localhost:3000
WAHA_API_KEY=
WAHA_SESSION=default

# ---- Telegram (used only when TRANSPORT_DRIVER includes 'telegram') ----
# Token from @BotFather.
TELEGRAM_BOT_TOKEN=
# Long-poll timeout (seconds); used only when no webhook URL is set below.
TELEGRAM_POLL_TIMEOUT=30
# Leave blank to long-poll (no public URL needed). Set to a public HTTPS URL to
# use webhook delivery instead: the server serves <host>/webhook/telegram and
# registers it via setWebhook on start. Example:
#   TELEGRAM_WEBHOOK_URL=https://your-host.example.com/webhook/telegram
TELEGRAM_WEBHOOK_URL=
# Optional shared secret; Telegram echoes it in X-Telegram-Bot-Api-Secret-Token.
TELEGRAM_WEBHOOK_SECRET=

# ---- Webhook server ----
PORT=8080
# Optional shared secret checked against WAHA's X-Api-Key / webhook hmac if configured.
WEBHOOK_SECRET=
